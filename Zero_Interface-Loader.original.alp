									<ActionCode>traceln("Starting model serialisation...");
J_ModelSave saveObject = new J_ModelSave();
saveObject.energyModel = energyModel;

energyModel.pop_gridNodes.forEach(x-&gt;saveObject.c_gridNodes.add(x));
energyModel.pop_GIS_Buildings.forEach(x-&gt;{saveObject.c_GISObjects.add(x); c_GISregions.put(x.p_id, x.gisRegion);x.f_writeStyleStrings();});
energyModel.pop_GIS_Objects.forEach(x-&gt;{saveObject.c_GISObjects.add(x); c_GISregions.put(x.p_id, x.gisRegion);x.f_writeStyleStrings();});
energyModel.pop_GIS_Parcels.forEach(x-&gt;{saveObject.c_GISObjects.add(x); c_GISregions.put(x.p_id, x.gisRegion);x.f_writeStyleStrings();});

/*
