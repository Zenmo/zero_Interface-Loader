    &#xD;
    //User GC acces type&#xD;
    @Builder.Default&#xD;
    OL_UserGCAccessType GCAccessType = OL_UserGCAccessType.FULL;&#xD;
    &#xD;
    List&lt;String&gt; accessibleCompanyIDs;&#xD;
}</Text>
