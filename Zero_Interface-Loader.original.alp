&#xD;
int total_vehicles = nbEvanCurrent + nbPetroleumFuelvansCurrent;&#xD;
&#xD;
int nbElectricVansGoal = roundToInt(total_vehicles*pctElectricVansGoal/100.0);&#xD;
&#xD;
if (nbEvanCurrent &lt; nbElectricVansGoal) {&#xD;
