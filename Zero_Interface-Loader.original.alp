sl_electricVansCompany.setEnabled(enable);&#xD;
sl_hydrogenVansCompany.setEnabled(enable);&#xD;
sl_petroleumFuelVansCompany.setEnabled(enable);&#xD;
&#xD;
sl_electricTrucksCompany.setEnabled(enable);&#xD;
