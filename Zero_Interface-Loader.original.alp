	OL_PBL_OwnershipType ownership_type;&#xD;
	OL_HouseholdCookingMethod cooking_type;&#xD;
	OL_GridConnectionInsulationLabel insulation_label;&#xD;
	Double local_factor;&#xD;
	Double regional_climate_correction_factor;&#xD;
}</Text>
