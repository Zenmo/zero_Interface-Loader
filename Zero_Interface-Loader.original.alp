						<Body>//Set back end range (to prevent anylogic errors)&#xD;
sl_electricTrucksCompany.setRange(0, 500);&#xD;
sl_petroleumFuelTrucksCompany.setRange(0, 500);&#xD;
sl_hydrogenTrucksCompany.setRange(0, 500);&#xD;
