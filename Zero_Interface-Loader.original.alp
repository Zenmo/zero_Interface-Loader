if (p_customMapOverlayLegend != null) {&#xD;
	p_customMapOverlayLegend.setVisible(false);&#xD;
}&#xD;
b_updateLiveCongestionColors = false;&#xD;
&#xD;
if(!b_inEnergyHubMode){&#xD;
