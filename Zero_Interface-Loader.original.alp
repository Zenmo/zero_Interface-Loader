						</Parameter>
						<Body>//CONCEPT VERSION&#xD;
J_TimeParameters timeParameters = energyModel.p_timeParameters;&#xD;
OL_EnergyCarriers energyCarrier = OL_EnergyCarriers.HEAT;&#xD;
J_ProfilePointer profilePointer = f_getPVTProfilePointer(ptOrientation);&#xD;
&#xD;
J_EAProduction production_asset = new J_EAProduction(parentGC, OL_EnergyAssetType.PHOTOVOLTAIC, asset_name, energyCarrier, installedPower_kW, timeParameters, profilePointer);</Body>
