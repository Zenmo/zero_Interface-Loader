						<Body>if (uI_Tabs.pop_tabEHub.size() &gt; 0){&#xD;
	if (uI_Tabs.pop_tabEHub.get(0).getButton_remove_nfato() != null){&#xD;
		uI_Tabs.pop_tabEHub.get(0).getButton_remove_nfato().action();&#xD;
