	    this.pvHousesWithBattery_pct = pvHousesWithBattery_pct;&#xD;
	}&#xD;
	&#xD;
	public void setCb_householdCurtailmentActive(boolean cb_householdCurtailmentActive) {&#xD;
	    this.cb_householdCurtailmentActive = cb_householdCurtailmentActive;&#xD;
	}&#xD;
&#xD;
