											<EnableExpression>!gr_ForceMapSelectionText.isVisible()</EnableExpression>
											<ActionCode>if( ! cb_filterOptions.getValue().equals("-")){
	if( c_selectedFilterOptions.contains(map_UINamesFilterOption.get(cb_filterOptions.getValue()))){
		f_setErrorScreen("Deze filter is al geselecteerd", 0, 0);
	}
	else {
		f_setPrefixFilter();
		f_setMapOverlay(); //Go back to base coloring of map							
		f_colorSelectedBuildings(c_filterMatrix.get(c_filterMatrix.size()-1)); //geen null check nodig want na selecteren van filter is er altijd 1	
	}
}
cb_filterOptions.setValueIndex(0, false);</ActionCode>
