							<Control Type="CheckBox">
								<EmbeddedIcon>false</EmbeddedIcon>
								<Id>1780213147396</Id>
								<Name>checkbox_netPlanes</Name>
								<X>1195</X>
								<Y>28</Y>
								<Label>
									<X>0</X>
									<Y>-10</Y>
								</Label>
								<PublicFlag>true</PublicFlag>
								<PresentationFlag>true</PresentationFlag>
								<ShowLabel>false</ShowLabel>
								<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
								<BasicProperties Width="110" Height="23">
									<EmbeddedIcon>false</EmbeddedIcon>
									<TextColor>-16777216</TextColor>
									<Enabled>true</Enabled>
									<ActionCode>if( checkbox_netPlanes.isSelected() ){
	java.util.Random rand = new java.util.Random(12345);
	for (GISRegion plane : c_GISNetplanes) {
	    plane.setVisible(true);
	    // Generate random colors with slight transparency
	    int red = 50 + rand.nextInt(200);
	    int green = 50 + rand.nextInt(200);
	    int blue = 50 + rand.nextInt(200);
	    plane.setFillColor(new java.awt.Color(red, green, blue, 128));
	    plane.setLineColor(java.awt.Color.BLACK);
	}
}
else{
	for (GISRegion plane : c_GISNetplanes) {
	    plane.setVisible(false);
	}
}</ActionCode>
