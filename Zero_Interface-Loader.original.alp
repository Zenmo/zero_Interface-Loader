						<Body>gisregion.setLineStyle( LINE_STYLE_SOLID );&#xD;
gisregion.setLineColor( v_MVLVLineColor );&#xD;
gisregion.setLineWidth(2);		&#xD;
gisregion.setFillColor(v_MVLVNodeColor);</Body>
