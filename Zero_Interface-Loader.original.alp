&#xD;
int nbPetroleumFuelCarsGoal = roundToInt(total_vehicles*pctPetroleumFuelCarsGoal/100.0);&#xD;
&#xD;
if (nbPetroleumFuelcarsCurrent &lt; nbPetroleumFuelCarsGoal) {&#xD;
	// Add PetroleumFuel Cars&#xD;
